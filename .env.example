# ──────────────────────────────────────────────────────────────
# Modelo de variáveis de ambiente — Planalto Negócios
# Copie este arquivo para `.env.local` e preencha os valores reais.
# ──────────────────────────────────────────────────────────────

# Segredo para assinar as sessões de login (JWT).
# Gere um novo com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Usuários do sistema interno. Formato: usuario:senha separados por vírgula.
# Ex.: admin:senhaForte,joao:outraSenha
SISTEMA_USUARIOS=admin:troque-esta-senha

# ──────────────────────────────────────────────────────────────
# Dados da empresa exibidos no site (NEXT_PUBLIC_ = embutidas no build).
# Deixe em branco para usar os placeholders genéricos de lib/empresa.ts.
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_EMPRESA_CNPJ=
NEXT_PUBLIC_EMPRESA_EMAIL=
NEXT_PUBLIC_EMPRESA_TELEFONE=
NEXT_PUBLIC_EMPRESA_INSTAGRAM=
NEXT_PUBLIC_EMPRESA_ENDERECO=
NEXT_PUBLIC_EMPRESA_CIDADE=
NEXT_PUBLIC_EMPRESA_CEP=

# ──────────────────────────────────────────────────────────────
# URL pública do site (usada em SEO/sitemap/robots).
# Definir no deploy. Fallback: https://planaltonegocios.com (lib/site.ts).
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ──────────────────────────────────────────────────────────────
# Envio real do formulário de contato (via Resend).
# DORMENTE enquanto RESEND_API_KEY estiver em branco: o formulário usa o
# fallback (mailto). Preencher quando o serviço de e-mail for contratado.
# ──────────────────────────────────────────────────────────────
RESEND_API_KEY=
CONTATO_DESTINO=
CONTATO_REMETENTE=
